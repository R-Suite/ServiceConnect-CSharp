<Project>
  <PropertyGroup>
    <!-- Default target frameworks for every project under src/. The library packages
         multi-target the current LTS (net8.0) and the latest STS (net10.0); test
         projects, the example filter, and anything else with framework-specific
         requirements override this in their own .csproj.

         Why these two and nothing older: net8.0 is the broadest LTS currently in
         support, and net10.0 unlocks System.Threading.Lock, the field keyword,
         and other recent BCL niceties used in the hot paths. We deliberately do
         NOT target netstandard2.x or net6.0/net7.0 — see the README's "Supported
         runtimes" section for the rationale and consumer guidance. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run IDE/style analyzers (IDE0xxx) during compile so .editorconfig violations
         become warnings, which TreatWarningsAsErrors promotes to build errors. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Emit XML documentation files so DocFX can build the API reference. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Pin language version per target framework. net8.0 stays on C# 12 so multi-targeting
       projects do not gain C# 13+ features (Lock object lock semantics, field keyword) under
       net8.0 — those features are guarded by #if NET9_0_OR_GREATER and must compile cleanly
       under both targets. net10.0 takes C# 14 (the SDK default) so expression-tree calls into
       interface methods with optional CancellationToken parameters compile (C# 13 enforces
       CS0854 here; C# 14 relaxes it). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <!-- Suppress audit advisories for vulnerabilities in transitive dependencies of MongoDB.Driver
       2.23.1 that have no available fix at the pinned driver version. These are transitive-only;
       the vulnerabilities are in compression libraries (SharpCompress, Snappier) that the driver
       bundles but that this codebase does not use directly or expose to untrusted input. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" /> <!-- SharpCompress 0.30.1 moderate -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pggp-6c3x-2xmx" /> <!-- Snappier 1.0.0 high -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.54">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
