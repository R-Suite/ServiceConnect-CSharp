<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run IDE/style analyzers (IDE0xxx) during compile so .editorconfig violations
         become warnings, which TreatWarningsAsErrors promotes to build errors. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Emit XML documentation files so DocFX can build the API reference. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress CS1591 (missing XML comment for publicly visible type or member). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!-- Pin language version per target framework. net8.0 stays on C# 12 so multi-targeting
       projects do not gain C# 13+ features (Lock object lock semantics, field keyword) under
       net8.0 — those features are guarded by #if NET9_0_OR_GREATER and must compile cleanly
       under both targets. net10.0 takes C# 14 (the SDK default) so expression-tree calls into
       interface methods with optional CancellationToken parameters compile (C# 13 enforces
       CS0854 here; C# 14 relaxes it). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
