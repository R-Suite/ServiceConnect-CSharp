<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>ServiceConnect.Persistence.MongoDb</PackageId>
        <AssemblyName>ServiceConnect.Persistence.MongoDb</AssemblyName>
        <Title>ServiceConnect.Persistence.MongoDb</Title>
        <Description>MongoDB process manager, aggregator and timeout persistence for ServiceConnect, with optional SSL/TLS.</Description>
        <PackageTags>ServiceConnect;Persistence;MongoDB;MessageBus;Messaging;Message;Bus;Service</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ServiceConnect.Interfaces\ServiceConnect.Interfaces.csproj" />
        <ProjectReference Include="..\ServiceConnect\ServiceConnect.csproj" />
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ServiceConnect.UnitTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ServiceConnect.EndToEndTests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <!-- DynamicProxyGenAssembly2 is the runtime-generated assembly Moq/Castle DynamicProxy
         emits its proxies into. Needed at both Debug and Release because Moq creates proxies
         on demand from test runs regardless of which configuration the SUT was built with.
         The full strong-name public key is required because MongoDB.Driver 3.x is strong-named:
         Castle's `AssertValidTypeForTarget` refuses to proxy a strong-named interface that
         references an internal type whose assembly's InternalsVisibleTo lacks the matching
         public-key token (security check against forged friend-assembly tokens). The key
         below is the public key of DynamicProxyGenAssembly2 published by Castle. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>DynamicProxyGenAssembly2, </_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MongoDB.Driver" Version="3.8.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
        <!-- Explicit overrides for MongoDB.Driver's transitive compression dependencies.
             Driver 3.x still bundles SharpCompress 0.30.1 (GHSA-6c8g-7p36-r338, zip-slip,
             moderate) and Snappier 1.0.0 (GHSA-pggp-6c3x-2xmx, DoS via malformed input,
             high). The driver does not exercise either format on the request path the
             persistors hit, but the vulnerable assemblies still ship in the consumer's
             bin output. Pinning patched versions here forces them up the dependency graph
             so consumers of ServiceConnect.Persistence.MongoDb get a clean
             NuGet vulnerability scan result without needing their own suppression. -->
        <PackageReference Include="SharpCompress" Version="1.0.0" />
        <PackageReference Include="Snappier" Version="1.3.1" />
    </ItemGroup>
</Project>
