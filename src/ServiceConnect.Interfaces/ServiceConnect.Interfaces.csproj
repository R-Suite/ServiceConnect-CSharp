<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ServiceConnect.Interfaces</AssemblyName>
    <PackageId>ServiceConnect.Interfaces</PackageId>
    <Title>ServiceConnect.Interfaces</Title>
    <Description>Public API contracts (IBus, IMessage, IConsumer, IProducer, options and headers) for the ServiceConnect messaging framework. Reference this package from libraries that need to type-check against ServiceConnect without taking a runtime dependency.</Description>
    <PackageTags>ServiceConnect;Interfaces;Contracts;MessageBus;Messaging;Message;Bus;Service</PackageTags>
  </PropertyGroup>

</Project>
