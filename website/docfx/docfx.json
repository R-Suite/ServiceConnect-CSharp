{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/ServiceConnect.sln"],
          "src": "../.."
        }
      ],
      "dest": "../../website/_docfx_metadata/reference",
      "filter": "filterConfig.yml",
      "disableGitFeatures": true,
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["reference/**/*.{md,yml}", "reference/*.{md,yml}"],
        "src": "../_docfx_metadata"
      },
      {
        "files": ["index.md", "toc.yml"],
        "src": "."
      }
    ],
    "globalMetadata": {
      "_appTitle": "ServiceConnect API Reference",
      "_appName": "ServiceConnect",
      "_enableSearch": false,
      "_disableContribution": true,
      "_disableNewTab": false
    },
    "dest": "../public/api",
    "template": ["default", "modern"],
    "postProcessors": ["ExtractSearchIndex"]
  }
}
